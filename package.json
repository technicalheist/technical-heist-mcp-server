{
  "name": "@technicalheist/technical-heist-mcp-server",
  "version": "1.0.4",
  "description": "Technical Heist MCP server for authentication, vault notes, 2FA authenticator, blog management with media uploads, tasks, and tenant-isolated docs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "technical-heist-mcp": "./dist/index.js",
    "technical-heist-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technicalheist/technical-heist-mcp-server.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "technicalheist",
    "vault",
    "notes",
    "authenticator",
    "totp",
    "2fa",
    "blog",
    "tasks",
    "todos",
    "docs",
    "documentation",
    "media",
    "uploads"
  ],
  "author": "Technical Heist",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "otpauth": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3"
  }
}
